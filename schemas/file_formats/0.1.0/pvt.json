{
  "$defs": {
    "PvtResultRow": {
      "description": "Represents the columns of a row in a pvt export.\n\nThese fields are the current agreed upon standard result. Changes to the fields or\ntheir validation should cause the version defined in the standard result schema to\nincrease the version number in a way that corresponds to the schema versioning\nspecification (i.e. they are a patch, minor, or major change).",
      "properties": {
        "COMPRESSIBILITY": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compressibility"
        },
        "GASDENSITY": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gasdensity"
        },
        "KEYWORD": {
          "title": "Keyword",
          "type": "string"
        },
        "OGR": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ogr"
        },
        "OILDENSITY": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oildensity"
        },
        "PRESSURE": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pressure"
        },
        "PVTNUM": {
          "minimum": 0,
          "title": "Pvtnum",
          "type": "integer"
        },
        "RS": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rs"
        },
        "VISCOSIBILITY": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Viscosibility"
        },
        "VISCOSITY": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Viscosity"
        },
        "VOLUMEFACTOR": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volumefactor"
        },
        "WATERDENSITY": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waterdensity"
        }
      },
      "required": [
        "PVTNUM",
        "KEYWORD"
      ],
      "title": "PvtResultRow",
      "type": "object"
    }
  },
  "$id": "https://main-fmu-schemas-dev.radix.equinor.com/schemas/file_formats/0.1.0/pvt.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Represents the resultant pvt parquet file, which is naturally a list of rows.\n\nConsumers who retrieve this parquet file must read it into a json-dictionary\nequivalent format to validate it against the schema.",
  "items": {
    "$ref": "#/$defs/PvtResultRow"
  },
  "title": "PvtResult",
  "type": "array",
  "version": "0.1.0"
}